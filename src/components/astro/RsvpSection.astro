---
import RsvpForm from '../react/RsvpForm';

const formId = import.meta.env.PUBLIC_FORMSPREE_FORM_ID;
---

<section
  id="rsvp"
  class="rsvp container mx-auto px-5 py-20 md:px-8 md:pt-[120px] md:pb-[135px]"
  aria-labelledby="rsvp-title"
>
  <div class="section-label">04 RSVP</div>
  <div class="rsvp-layout mt-[50px] grid grid-cols-1 gap-y-12 md:grid-cols-2 md:gap-[12%]">
    <div>
      <h2 id="rsvp-title" class="text-shadow-lg">
        Ci sarete?
      </h2>
      <p class="copy-text">
        Fatecelo sapere entro il <span class="font-bold">18 gennaio 2027</span>.
        <br />E non dimenticate di indicarci la vostra canzone d'amore
        preferita!
      </p>
    </div>

    <RsvpForm client:load {formId} />
  </div>
</section>
