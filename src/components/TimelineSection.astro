<section
  id="timeline"
  class="timeline w-full bg-primary px-5 py-20 text-paper md:px-[max(32px,calc((100%-1180px)/2))] md:pt-[100px] md:pb-[115px]"
  aria-labelledby="timeline-title"
>
  <div class="section-label text-paper">
    <span>03</span> In agenda
  </div>
  <div class="my-[45px] block md:my-12 md:mb-16.25 md:flex md:items-end md:justify-between">
    <div>
      <h2 id="timeline-title" class="text-shadow-lg">
        Il programma
      </h2>
    </div>
  </div>
  <div class="block border-t border-[rgb(248_246_240/25%)] md:grid md:grid-cols-4">
    <div class="timeline-item">
      <time>11:00</time>
      <span class="timeline-dot"></span>
      <div>
        <h3>La cerimonia</h3>
        <p>Comune di Padova</p>
      </div>
    </div>
    <div class="timeline-item">
      <time>12:30</time>
      <span class="timeline-dot"></span>
      <div>
        <h3>Aperitivo</h3>
        <p>Presso Antica Masseria</p>
      </div>
    </div>
    <div class="timeline-item">
      <time>14:00</time>
      <span class="timeline-dot"></span>
      <div>
        <h3>Pranzo in compagnia</h3>
        <p>Accompagnato da attività divertenti!</p>
      </div>
    </div>
    <div class="timeline-item">
      <time>17:00</time>
      <span class="timeline-dot"></span>
      <div>
        <h3>Taglio della torta</h3>
        <p>Perché la dolcezza non è mai troppa</p>
      </div>
    </div>
  </div>
</section>
