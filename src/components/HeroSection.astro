---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
---

<section class="relative w-full" aria-labelledby="hero-title">
  <div class="container relative mx-auto flex min-h-0 flex-col items-stretch gap-[45px] px-5 pt-[70px] pb-[70px] md:grid md:min-h-[calc(100vh-88px)] md:grid-cols-[1fr_.82fr] md:grid-rows-[1fr_auto] md:items-center md:gap-x-[8%] md:gap-y-0 md:px-8 md:pt-[30px] md:pb-6">
    <div class="relative z-1">
      <p class="eyebrow">
        Save the date <span class="rule"></span> 18.03.2027
      </p>

      <h1 id="hero-title">
        <span class="bride-name text-shadow-lg">Giulia</span>
        <em class="text-shadow-lg">&amp;</em>
        <span class="groom-name text-shadow-lg">Mattia</span>
      </h1>

      <p class="hero-intro mb-4">
        Ci sposiamo!
        <br />E non vediamo l'ora di festeggiare con voi.
      </p>

      <a class="button button-primary" href="#rsvp">
        Ci sarete? <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="aspect-[0.88] w-4/5 self-center overflow-hidden border-4 border-dashed border-tertiary p-2 md:p-3 rotate-5 rounded-xl md:w-auto md:self-auto">
      <Image
        src={heroImage}
        alt="Giulia e Mattia"
        widths={[480, 720, 960]}
        sizes="(max-width: 768px) 78vw, 38vw"
        class="block size-full rounded-md object-cover object-[center_65%]"
      />
    </div>

    <a
      class="scroll-cue hidden md:col-span-2 md:flex md:justify-self-start"
      href="#story"
    >
      <span>Scorri</span>
      <i aria-hidden="true">→</i>
    </a>
  </div>
</section>
