<section id="rsvp" class="rsvp section-shell" aria-labelledby="rsvp-title">
  <div class="section-label">05 RSVP</div>
  <div class="rsvp-layout">
    <div>
      <h2 id="rsvp-title" class="text-shadow-lg">
        Ci sarete?
      </h2>
      <p class="lead">
        Fatecelo sapere entro il <span class="font-bold">18 gennaio 2027</span>.
        <br />E non dimenticate di indicarci la vostra canzone d'amore
        preferita!
      </p>
    </div>
    <form class="rsvp-form">
      <label>
        Il tuo nome
        <input type="text" name="name" placeholder="Nome e cognome" />
      </label>
      <label>
        Quanti sarete?
        <select name="guests">
          <option>1 persona</option>
          <option>2 persone</option>
          <option>3 persone</option>
          <option>4 persone</option>
          <option>5 persone</option>
          <option>6 persone</option>
        </select>
      </label>
      <label>
        Allergie o intolleranze
        <textarea
          name="notes"
          rows="2"
          placeholder="Scrivici qui, se necessario"
        ></textarea>
      </label>
      <label>
        La vostra canzone d'amore preferita 🩵
        <input type="text" name="song" placeholder="Titolo e artista" />
      </label>
      <button class="button button-dark" type="submit">
        Conferma <span aria-hidden="true">↗</span>
      </button>
    </form>
  </div>
</section>
