import CakeSection from '../components/astro/CakeSection.astro';
import FaqSection from '../components/astro/FaqSection.astro';
import HeroSection from '../components/astro/HeroSection.astro';
import RsvpSection from '../components/astro/RsvpSection.astro';
import SiteFooter from '../components/astro/SiteFooter.astro';
import SiteHeader from '../components/astro/SiteHeader.astro';
import StorySection from '../components/astro/StorySection.astro';
import TimelineSection from '../components/astro/TimelineSection.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <SiteHeader />

  <main id="top">
    <HeroSection />
    <StorySection />
    <EventDetails />
    <CakeSection />
    <TimelineSection />
    <RsvpSection />
    <FaqSection />
