<section id="rsvp" class="rsvp section-shell" aria-labelledby="rsvp-title">
  <div class="section-label">
    <span>05</span> RSVP
  </div>
  <div class="rsvp-layout">
    <div>
      <p class="eyebrow">Entro il 30 giugno 2026</p>
      <h2 id="rsvp-title">Ci sarete?</h2>
      <p class="lead">
        Fatecelo sapere: non vediamo l'ora di contarvi tra i nostri invitati.
      </p>
    </div>
    <form class="rsvp-form">
      <label>
        Il tuo nome
        <input type="text" name="name" placeholder="Nome e cognome" />
      </label>
      <label>
        Quante persone?
        <select name="guests">
          <option>1 persona</option>
          <option>2 persone</option>
          <option>3 persone</option>
          <option>4 persone</option>
        </select>
      </label>
      <label>
        Allergie o intolleranze
        <textarea
          name="notes"
          rows="2"
          placeholder="Scrivici qui, se necessario"
        ></textarea>
      </label>
      <label>
        Una canzone per la festa
        <input type="text" name="song" placeholder="Titolo e artista" />
      </label>
      <button class="button button-dark" type="submit">
        Invia la conferma <span aria-hidden="true">↗</span>
      </button>
    </form>
  </div>
</section>
